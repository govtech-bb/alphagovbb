# Shared secret used to enter draft-preview mode.
# Reviewers visit /preview?token=<value> to set a signed cookie and see pages
# whose frontmatter has `draft: true`. Generate with: openssl rand -hex 32
PREVIEW_SECRET=

# Feedback form (optional in dev)
MAIL_FROM=
FEEDBACK_TO_EMAIL=
# SES_REGION=us-east-1
# SES_CONFIGURATION_SET=
# SES_TAG_KEY=ses:configuration-set
# SES_TAG_VALUE=prod
